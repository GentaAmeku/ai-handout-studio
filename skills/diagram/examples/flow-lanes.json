  "nodes": [
    { "id": "search", "label": "検索して店舗を開く", "role": "user" },
    { "id": "list", "label": "おすすめの一覧", "sub": "人気順に並ぶ", "role": "screen" },
    { "id": "filter", "label": "条件で絞り込む", "role": "user" },
    { "id": "table", "label": "比較表", "sub": "価格・評価を並べる", "role": "screen" },
    { "id": "detail", "label": "商品の詳細", "role": "screen" },
    { "id": "click", "label": "購入ボタンを押す", "role": "user" },
