    { "id": "worker", "label": "注文の処理", "role": "process" },
    { "id": "template", "label": "文面の雛形", "sub": "template.md", "role": "output", "change": "changed" },
    { "id": "payment", "label": "支払いの確認", "sub": "payment.py", "role": "process" },
    { "id": "alloc", "label": "在庫の引き当て", "sub": "stock.py", "role": "process", "change": "new" },
    { "id": "stock", "label": "在庫のデータ", "role": "data" },
