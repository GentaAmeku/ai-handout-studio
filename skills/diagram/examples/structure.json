  ],
  "edges": [
    { "from": "shop", "to": "accept", "label": "注文時に起動" },
    { "from": "accept", "to": "worker" },
    { "from": "worker", "to": "template", "label": "読む" },
    { "from": "worker", "to": "payment", "label": "実行" },
    { "from": "worker", "to": "alloc", "label": "実行", "change": "new" },
    { "from": "alloc", "to": "stock", "change": "new" },
    { "from": "alloc", "to": "arrival", "change": "new" },
    { "from": "worker", "to": "mail", "label": "送信" }
