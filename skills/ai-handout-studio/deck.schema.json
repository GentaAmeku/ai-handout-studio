{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "template": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "size": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "const": 1280
        },
        "height": {
          "type": "number",
          "const": 720
        }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["draft", "done"]
    },
    "meta": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["createdAt", "updatedAt"],
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "type": "string",
            "enum": ["cover", "section", "content", "closing"]
          },
          "notes": {
            "type": "string"
          },
          "background": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "heading"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "kicker": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "level": {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 1
                            },
                            {
                              "type": "number",
                              "const": 2
                            }
                          ]
                        }
                      },
                      "required": ["text", "level"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "align": {
                          "type": "string",
                          "enum": ["left", "center", "right"]
                        }
                      },
                      "required": ["text"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "bullets"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "marker": {
                          "type": "string",
                          "enum": ["disc", "number"]
                        }
                      },
                      "required": ["items"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "card-grid"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "columns": {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 2
                            },
                            {
                              "type": "number",
                              "const": 3
                            },
                            {
                              "type": "number",
                              "const": 4
                            }
                          ]
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string"
                              },
                              "body": {
                                "type": "string"
                              },
                              "icon": {
                                "type": "string",
                                "enum": [
                                  "target",
                                  "trending-up",
                                  "book-open",
                                  "settings",
                                  "circle-check",
                                  "lightbulb",
                                  "users",
                                  "chart-column",
                                  "flag",
                                  "clock",
                                  "shield-check",
                                  "rocket",
                                  "message-circle",
                                  "file-text",
                                  "search",
                                  "wrench",
                                  "sparkles"
                                ]
                              }
                            },
                            "required": ["title", "body"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["columns", "items"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "kpi-row"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              },
                              "note": {
                                "type": "string"
                              }
                            },
                            "required": ["value", "label"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["items"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "two-col"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "left": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "body": {
                              "type": "string"
                            }
                          },
                          "required": ["body"],
                          "additionalProperties": false
                        },
                        "right": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "body": {
                              "type": "string"
                            }
                          },
                          "required": ["body"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["left", "right"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "process"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "steps": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string"
                              },
                              "body": {
                                "type": "string"
                              }
                            },
                            "required": ["title", "body"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["steps"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "table"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "headers": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "required": ["headers", "rows"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "image"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "src": {
                          "type": "string",
                          "pattern": "^assets\\/[^:\\\\]+$"
                        },
                        "fit": {
                          "type": "string",
                          "enum": ["cover", "contain"]
                        },
                        "caption": {
                          "type": "string"
                        }
                      },
                      "required": ["src"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "w": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "h": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "const": "footer"
                    },
                    "props": {
                      "type": "object",
                      "properties": {
                        "showPage": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": ["x", "y", "w", "h", "id", "type", "props"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["id", "layout", "blocks"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "title", "size", "status", "meta", "slides"],
  "additionalProperties": false,
  "title": "ai-handout-studio deck",
  "description": "1280x720 のスライド資料。色・フォントは持たず、文章・構造・配置だけを持つ。"
}
