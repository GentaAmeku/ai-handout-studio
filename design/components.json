        "label": "帯",
        "vars": {
          "notice-border-width": "0px",
          "notice-bar-width": "4px",
          "notice-radius": "var(--radius-sm)"
        }
      },
      "box": {
        "label": "箱",
        "vars": {
          "notice-border-width": "1px",
          "notice-bar-width": "1px",
          "notice-radius": "var(--radius-sm)"
        }
      }
    },
    "params": {
      "accent": {
        "label": "帯の色",
        "default": "muted",
        "options": {
          "muted": {
            "label": "控えめ",
            "vars": {
              "notice-base-color": "var(--color-muted)"
            }
          },
          "accent2": {
            "label": "差し色2",
            "vars": {
              "notice-base-color": "var(--color-accent2)"
            }
          },
          "accent3": {
            "label": "差し色3",
            "vars": {
              "notice-base-color": "var(--color-accent3)"
            }
          }
        }
      }
    }
  },
  "figure": {
    "label": "図",
    "default": "rounded",
    "variants": {
      "rounded": {
        "label": "角丸の箱",
        "vars": {
          "figure-node-radius": "var(--radius-sm)",
          "figure-link-width": "1",
          "figure-arrow-scale": "1"
        }
      },
      "square": {
        "label": "角の箱",
        "vars": {
          "figure-node-radius": "0px",
          "figure-link-width": "1",
          "figure-arrow-scale": "1"
        }
      }
    },
    "shape": {
      "box": {
        "label": "箱の形",
        "options": {
          "rounded": {
            "label": "角丸",
            "vars": {
              "figure-node-radius": "var(--radius-sm)"
            }
          },
          "square": {
            "label": "角",
            "vars": {
              "figure-node-radius": "0px"
            }
          },
          "pill": {
            "label": "両端が丸い",
            "vars": {
              "figure-node-radius": "24px"
            }
          },
          "ellipse": {
            "label": "楕円",
            "vars": {
              "figure-node-radius": "999px"
            }
          }
        }
      },
      "line": {
        "label": "線の太さ",
        "options": {
          "thin": {
            "label": "細い",
            "vars": {
              "figure-link-width": "1"
            }
          },
          "bold": {
            "label": "太い",
            "vars": {
              "figure-link-width": "2"
            }
          }
        }
      },
      "arrow": {
        "label": "矢印の頭",
        "options": {
          "normal": {
            "label": "標準",
            "vars": {
              "figure-arrow-scale": "1"
            }
          },
          "large": {
            "label": "大きい",
            "vars": {
              "figure-arrow-scale": "1.5"
            }
          }
        }
      }
    },
    "params": {
      "arrow": {
        "label": "矢印",
        "default": "solid",
        "options": {
          "solid": {
            "label": "塗り",
            "vars": {
              "figure-arrow-fill": "var(--color-muted)",
              "figure-arrow-stroke-width": "0"
            }
          },
          "open": {
            "label": "白抜き",
            "vars": {
              "figure-arrow-fill": "var(--color-bg)",
              "figure-arrow-stroke-width": "1"
            }
          }
        }
      },
      "line": {
        "label": "線",
        "default": "solid",
        "options": {
          "solid": {
            "label": "実線",
            "vars": {
              "figure-link-dash": "none"
            }
          },
          "dashed": {
            "label": "破線",
            "vars": {
              "figure-link-dash": "4 3"
            }
          }
        }
      }
    }
