node_modules/
dist/
*.tsbuildinfo
.DS_Store

# 手元だけの作業の決まり。CLAUDE.md からは読まず、CLAUDE.local.md から読む
CLAUDE.local.md
.dev

# 手元の設定。mise の絶対パスなど、環境ごとに違う値を持つので git に入れない。
# .agents/skills/(clone したあとの studio-setup)と .claude/skills/ の symlink は git に入れる
.claude/launch.json
.claude/settings.local.json
.claude/worktrees/

# 資料データはアプリコードと分ける。
# 質問票の回答には会話の内容が入るので、これも git に入れない
workspace/decks/
workspace/sheets/
workspace/documents/
# 読み手のメモ。他人について書くので、資料と同じく git に入れない
workspace/readers/
# お気に入り。資料の id の並びで、資料と同じく git に入れない
workspace/favorites.json
# 見本を入れた印。開発サーバーが空のワークスペースに見本を入れたときに作る
workspace/examples.json
# 利用者ごとの設定(組織名・言語・任意の機能)。無ければ既定値で読む
workspace/profile.json

# Claude Code が mod を読み込んだときに書く型(中にも .gitignore を置くが、念のため)
mods/*/.claude-plugin/types/

# デモ動画(video/README.md)。録画・BGM・書き出した mp4 は作り直せるので git に入れない。
# GIF は docs/images/<lang>/ に書き出して commit する
video/node_modules/
video/out/
video/public/clips/
video/public/bgm.wav
